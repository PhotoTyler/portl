rules_version = '2';

// PortL server listing. Paste this into Firebase console > Firestore Database > Rules > Publish.
// Limits must match LIMITS / TAGS / REPORT_REASONS in js/common.js.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // A Google account. Anonymous sign-in is only used to count "Open in PortL" once per browser,
    // so it must not be enough to add servers, like, favourite or report.
    function realUser() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function serverPath(id) {
      return /databases/$(database)/documents/servers/$(id);
    }

    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function validTags(t) {
      return t is list
        && t.size() <= 5
        && t.toSet().size() == t.size()
        && t.hasOnly(['survival', 'creative', 'smp', 'pvp', 'minigames', 'skyblock', 'parkour',
                      'roleplay', 'building', 'economy', 'factions', 'hardcore', 'vanilla',
                      'addons', 'family-friendly']);
    }

    // 'moderation' is written only by the report checker (GitHub Action, Admin SDK): it says why a
    // server was made private after reports. 'likeCount' / 'addCount' only change by exactly one,
    // together with the matching likes/adds document (see below).
    function validServer(d) {
      return d.keys().hasOnly(['ownerUid', 'name', 'host', 'port', 'description', 'tags',
                               'visibility', 'createdAt', 'updatedAt', 'moderation',
                               'likeCount', 'addCount'])
        && d.keys().hasAll(['ownerUid', 'name', 'host', 'port', 'description', 'tags',
                            'visibility', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 48
        && d.host is string && d.host.size() >= 1 && d.host.size() <= 253
        && d.host.matches('^[A-Za-z0-9.-]+$')
        && d.port is int && d.port >= 1 && d.port <= 65535
        && d.description is string && d.description.size() <= 300
        && validTags(d.tags)
        && d.visibility in ['public', 'private']
        && d.createdAt is timestamp
        && d.updatedAt == request.time;
    }

    match /servers/{serverId} {
      // Anyone can open a server page by its ID. Private servers are "unlisted": they never
      // appear in Discover or any list query, but work for people who have the link / QR code.
      allow get: if true;

      // Lists (Discover, My Servers) only ever return public servers or the caller's own.
      allow list: if resource.data.visibility == 'public'
        || (signedIn() && resource.data.ownerUid == request.auth.uid);

      allow create: if realUser()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && !('moderation' in request.resource.data)
        && request.resource.data.get('likeCount', 0) == 0
        && request.resource.data.get('addCount', 0) == 0
        && validServer(request.resource.data);

      // The owner editing their server. Counts and moderation can't be touched.
      allow update: if realUser()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.get('moderation', null) == resource.data.get('moderation', null)
        && request.resource.data.get('likeCount', 0) == resource.data.get('likeCount', 0)
        && request.resource.data.get('addCount', 0) == resource.data.get('addCount', 0)
        && validServer(request.resource.data);

      // Like / unlike: likeCount +1 or -1 in the same batch as creating / deleting likes/<uid>.
      allow update: if realUser()
        && onlyChanged(['likeCount'])
        && ((request.resource.data.likeCount == resource.data.get('likeCount', 0) + 1
              && !exists(/databases/$(database)/documents/servers/$(serverId)/likes/$(request.auth.uid))
              && existsAfter(/databases/$(database)/documents/servers/$(serverId)/likes/$(request.auth.uid)))
            || (request.resource.data.likeCount == resource.data.get('likeCount', 0) - 1
              && exists(/databases/$(database)/documents/servers/$(serverId)/likes/$(request.auth.uid))
              && !existsAfter(/databases/$(database)/documents/servers/$(serverId)/likes/$(request.auth.uid))));

      // "Open in PortL" count: +1 once per account (anonymous is fine) with adds/<uid>.
      allow update: if signedIn()
        && onlyChanged(['addCount'])
        && request.resource.data.addCount == resource.data.get('addCount', 0) + 1
        && !exists(/databases/$(database)/documents/servers/$(serverId)/adds/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/servers/$(serverId)/adds/$(request.auth.uid));

      allow delete: if realUser() && resource.data.ownerUid == request.auth.uid;

      match /likes/{uid} {
        allow get: if realUser() && uid == request.auth.uid;
        allow create: if realUser() && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time
          && getAfter(serverPath(serverId)).data.get('likeCount', 0) == get(serverPath(serverId)).data.get('likeCount', 0) + 1;
        allow delete: if realUser() && uid == request.auth.uid
          && getAfter(serverPath(serverId)).data.get('likeCount', 0) == get(serverPath(serverId)).data.get('likeCount', 0) - 1;
      }

      match /adds/{uid} {
        allow get: if signedIn() && uid == request.auth.uid;
        allow create: if signedIn() && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time
          && getAfter(serverPath(serverId)).data.get('addCount', 0) == get(serverPath(serverId)).data.get('addCount', 0) + 1;
      }
    }

    // Each user's favourite servers. Private to that user.
    match /users/{uid}/favorites/{serverId} {
      allow read, delete: if realUser() && uid == request.auth.uid;
      allow create: if realUser() && uid == request.auth.uid
        && serverId.matches('^[A-Za-z0-9]{1,40}$')
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
    }

    // Server status, written every 15 min by the status checker (GitHub Action).
    match /meta/status {
      allow get: if true;
    }

    match /reports/{reportId} {
      // Google accounts can report a server they don't own, once: the report ID is
      // "<serverId>_<uid>", and an existing report can't be overwritten (that would be an update).
      // Nobody can read, change or delete reports from the website. The report checker
      // (GitHub Action) counts 'open' reports and marks the ones it acts on.
      allow create: if realUser()
        && request.resource.data.keys().hasOnly(['serverId', 'reason', 'details', 'reporterUid', 'createdAt', 'status'])
        && request.resource.data.keys().hasAll(['serverId', 'reason', 'details', 'reporterUid', 'createdAt', 'status'])
        && request.resource.data.serverId is string
        && request.resource.data.serverId.matches('^[A-Za-z0-9]{1,40}$')
        && reportId == request.resource.data.serverId + '_' + request.auth.uid
        && exists(serverPath(request.resource.data.serverId))
        && get(serverPath(request.resource.data.serverId)).data.ownerUid != request.auth.uid
        && request.resource.data.reason in ['broken', 'inappropriate', 'spam', 'impersonation', 'other']
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 300
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
