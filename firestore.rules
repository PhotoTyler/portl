rules_version = '2';

// PortL server listing. Paste this into Firebase console > Firestore Database > Rules > Publish.
// Limits must match LIMITS / TAGS / REPORT_REASONS in js/common.js.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function validTags(t) {
      return t is list
        && t.size() <= 5
        && t.toSet().size() == t.size()
        && t.hasOnly(['survival', 'creative', 'smp', 'pvp', 'minigames', 'skyblock', 'parkour',
                      'roleplay', 'building', 'economy', 'factions', 'hardcore', 'vanilla',
                      'addons', 'family-friendly']);
    }

    function validServer(d) {
      return d.keys().hasOnly(['ownerUid', 'name', 'host', 'port', 'description', 'tags',
                               'visibility', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['ownerUid', 'name', 'host', 'port', 'description', 'tags',
                            'visibility', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 48
        && d.host is string && d.host.size() >= 1 && d.host.size() <= 253
        && d.host.matches('^[A-Za-z0-9.-]+$')
        && d.port is int && d.port >= 1 && d.port <= 65535
        && d.description is string && d.description.size() <= 300
        && validTags(d.tags)
        && d.visibility in ['public', 'private']
        && d.createdAt is timestamp
        && d.updatedAt == request.time;
    }

    match /servers/{serverId} {
      // Anyone can open a server page by its ID. Private servers are "unlisted": they never
      // appear in Discover or any list query, but work for people who have the link / QR code.
      allow get: if true;

      // Lists (Discover, My Servers) only ever return public servers or the caller's own.
      allow list: if resource.data.visibility == 'public'
        || (signedIn() && resource.data.ownerUid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && validServer(request.resource.data);

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && validServer(request.resource.data);

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /reports/{reportId} {
      // Anyone (signed in or not) can file a report about an existing server.
      // Nobody can read, change or delete reports from the website; review them in the console.
      allow create: if request.resource.data.keys().hasOnly(['serverId', 'reason', 'details', 'reporterUid', 'createdAt'])
        && request.resource.data.keys().hasAll(['serverId', 'reason', 'details', 'reporterUid', 'createdAt'])
        && request.resource.data.serverId is string
        && request.resource.data.serverId.matches('^[A-Za-z0-9]{1,40}$')
        && exists(/databases/$(database)/documents/servers/$(request.resource.data.serverId))
        && request.resource.data.reason in ['broken', 'inappropriate', 'spam', 'impersonation', 'other']
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 300
        && (request.resource.data.reporterUid == null
            || (signedIn() && request.resource.data.reporterUid == request.auth.uid))
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
